+// Standalone SDL test: compile with function sections and link with section GC.
+// This includes the actual host UI to exercise hotkeys and window resizing.
+#include "../host/window.cpp"
+#include <cassert>
+
+namespace ps2 { Options g_options; }
+
+int main()
+{
+    assert(SDL_Init(SDL_INIT_VIDEO) == 0);
+    g_window = SDL_CreateWindow("scaling test", 0, 0, 960, 720, SDL_WINDOW_RESIZABLE);
+    assert(g_window);
+    ps2::g_presentation_options.native_width.store(512);
+    ps2::g_presentation_options.native_height.store(448);
+    SDL_KeyboardEvent key{};
+    key.keysym.scancode = SDL_SCANCODE_2;
+    key.keysym.mod = KMOD_CTRL | KMOD_SHIFT;
+    assert(handle_hotkey(key));
+    assert(g_preferences.scaling == 6);
+    assert(ps2::g_presentation_options.render_scale.load() == 2);
+    resize_for_scaling();
+    int width = 0, height = 0;
+    SDL_GetWindowSize(g_window, &width, &height);
+    // The dummy test display is 1024x768, so the requested 2x falls back to 1x.
+    assert(width == 512 && height == 448);
+
+    key.keysym.mod = KMOD_CTRL;
+    assert(handle_hotkey(key));
+    resize_for_scaling();
+    SDL_GetWindowSize(g_window, &width, &height);
+    assert(width == 597 && height == 448);
+    g_preferences.render_scale = 4;
+    key.keysym.scancode = SDL_SCANCODE_3;
+    assert(handle_hotkey(key));
+    assert(g_preferences.scaling == 4);
+    assert(ps2::g_presentation_options.render_scale.load() == 4);
+    SDL_DestroyWindow(g_window);
+    SDL_Quit();
+    std::puts("SDL hotkeys resize the window and select matching or overridden GPU resolution.");
+}
