+    std::vector<std::uint32_t> clut(512, 0x11223344u);
+    write_state(native, 1, clut);
+    for (unsigned scale : {2u, 3u, 4u, 1u})
+    {
+        assert(change_render_scale(scale));
+        ps2::g_presentation_options.render_scale.store(static_cast<int>(scale));
+        std::vector<std::uint32_t> samples, saved_clut;
+        std::uint32_t actual = 0;
+        read_state(samples, actual, saved_clut);
+        assert(actual == scale && samples.size() == native.size() * scale * scale);
+        for (std::size_t word = 0; word < native.size(); ++word)
+            for (unsigned k = 0; k < scale * scale; ++k)
+                assert(samples[word * scale * scale + k] == native[word]);
+        assert(saved_clut == clut);
+        std::vector<std::uint32_t> frame;
+        std::uint32_t width = 0, height = 0;
+        const DisplaySource source{0, 8, 0, 0, 0, 16, 16, false};
+        assert(display(source, frame, width, height));
+        assert(width == 16 * scale && height == 16 * scale);
+        for (auto pixel : frame) assert(pixel == (native[0] | 0xFF000000u));
+    }
+    // Distinct subpixel samples must survive a real upscale/downscale as well.
+    assert(change_render_scale(3));
+    auto detailed = ps2::rescale_vram_samples(native, 1, 3);
+    for (std::size_t i = 0; i < detailed.size(); ++i) detailed[i] ^= static_cast<std::uint32_t>(i % 9);
+    write_state(detailed, 3, clut);
+    assert(change_render_scale(4));
+    std::vector<std::uint32_t> actual, saved_clut;
+    std::uint32_t scale = 0;
+    read_state(actual, scale, saved_clut);
+    assert(scale == 4 && actual == ps2::rescale_vram_samples(detailed, 3, 4));
+    std::puts("Live GPU scale changes 1/2/3/4 preserve VRAM and CLUT state.");
+}
