+"""Optional offscreen shader test; requires the Python wgpu package."""
+from pathlib import Path
+import struct
+import wgpu
+
+root = Path(__file__).resolve().parents[1]
+adapter = wgpu.gpu.request_adapter_sync(power_preference="low-power")
+device = adapter.request_device_sync()
+module = device.create_shader_module(code=(root / "runtime/src/gs/gpu/blit.wgsl").read_text())
+pipeline = device.create_render_pipeline(
+    layout="auto",
+    vertex={"module": module, "entry_point": "vs", "buffers": []},
+    fragment={"module": module, "entry_point": "fs", "targets": [{"format": "rgba8unorm"}]},
+    primitive={"topology": "triangle-list"},
+)
+pixels = device.create_buffer_with_data(
+    data=struct.pack("8I", 0xFF0000FF, 0xFF00FF00, 0xFFFF0000, 0xFFFFFFFF, *([0xFF000000] * 4)),
+    usage=wgpu.BufferUsage.STORAGE,
+)
+
+
+def render(nearest, blend, size):
+    uniform = device.create_buffer_with_data(
+        data=struct.pack("8I", 2, 2, 0, 4, blend, size, size, nearest),
+        usage=wgpu.BufferUsage.UNIFORM,
+    )
+    group = device.create_bind_group(
+        layout=pipeline.get_bind_group_layout(0),
+        entries=[
+            {"binding": 0, "resource": {"buffer": pixels, "offset": 0, "size": 32}},
+            {"binding": 1, "resource": {"buffer": uniform, "offset": 0, "size": 32}},
+        ],
+    )
+    texture = device.create_texture(
+        size=(10, 10, 1), format="rgba8unorm",
+        usage=wgpu.TextureUsage.RENDER_ATTACHMENT | wgpu.TextureUsage.COPY_SRC,
+    )
+    encoder = device.create_command_encoder()
+    draw = encoder.begin_render_pass(color_attachments=[{
+        "view": texture.create_view(), "resolve_target": None,
+        "load_op": "clear", "store_op": "store", "clear_value": (0, 0, 0, 1),
+    }])
+    draw.set_viewport(2, 2, size, size, 0, 1)
+    draw.set_pipeline(pipeline)
+    draw.set_bind_group(0, group)
+    draw.draw(3)
+    draw.end()
+    device.queue.submit([encoder.finish()])
+    image = device.queue.read_texture({"texture": texture}, {"bytes_per_row": 256, "rows_per_image": 10}, (10, 10, 1))
+
+    def pixel(x, y):
+        offset = y * 256 + x * 4
+        return tuple(image[offset:offset + 4])
+
+    assert pixel(0, 0) == (0, 0, 0, 255), "Letterbox area must stay black"
+    return pixel
+
+
+nearest = render(1, 0, 4)
+assert nearest(2, 2) == (255, 0, 0, 255)
+assert nearest(5, 2) == (0, 255, 0, 255)
+assert nearest(2, 5) == (0, 0, 255, 255)
+assert nearest(5, 5) == (255, 255, 255, 255)
+blended = render(1, 1, 4)
+assert blended(2, 2)[0] in (127, 128) and blended(2, 2)[1:] == (0, 0, 255)
+smooth = render(0, 0, 5)
+assert all(126 <= channel <= 129 for channel in smooth(4, 4)[:3])
+print("Offscreen nearest, smooth, field blending and letterboxing tests passed.")
