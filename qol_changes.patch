+#include "ps2/disc.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+int main(int argc, char **argv)
+{
+    assert(argc >= 2);
+    using namespace ps2::disc;
+    if (argc >= 3 && std::strcmp(argv[2], "--reject") == 0)
+    {
+        assert(!open(argv[1]));
+        return 0;
+    }
+    assert(open(argv[1]));
+    const auto asset = find("cdrom0:\\data\\Mixed Name.bin;1");
+    assert(asset && !asset->directory && asset->size == 7001);
+    const auto nested = find("DATA");
+    assert(nested && nested->directory);
+    const auto empty = find("EMPTY.DAT");
+    assert(empty && empty->size == 0);
+    const auto late_directory_entry = find("MANY/ENTRY_095_LONG_FILENAME.DAT");
+    assert(late_directory_entry && late_directory_entry->size == 0);
+    const auto system = find("system.cnf;1");
+    assert(system && system->size > 0);
+    assert(!find("MISSING.FILE"));
+    std::vector<std::uint8_t> bytes(kSector * 4, 0xEE);
+    assert(read(asset->sector, 4, bytes.data()));
+    for (std::size_t i = 0; i < 7001; ++i) assert(bytes[i] == static_cast<std::uint8_t>(i * 37 + 13));
+    for (std::size_t i = 7001; i < bytes.size(); ++i) assert(bytes[i] == 0);
+    assert(read(asset->sector + 1, 1, bytes.data()));
+    for (std::size_t i = 0; i < kSector; ++i) assert(bytes[i] == static_cast<std::uint8_t>((i + kSector) * 37 + 13));
+    assert(read(16, 1, bytes.data()));
+    assert(bytes[0] == 1 && std::memcmp(bytes.data() + 1, "CD001", 5) == 0);
+    const auto lba = asset->sector;
+    if (argc >= 3)
+    {
+        std::FILE *output = std::fopen(argv[2], "wb");
+        assert(output);
+        for (std::uint64_t sector = 0; sector < sector_count(); ++sector)
+        {
+            assert(read(static_cast<std::uint32_t>(sector), 1, bytes.data()));
+            assert(std::fwrite(bytes.data(), 1, kSector, output) == kSector);
+        }
+        assert(std::fclose(output) == 0);
+        assert(open(argv[2]));
+        assert(find("DATA/MIXED NAME.BIN")->sector == lba);
+        assert(read(lba, 1, bytes.data()) && bytes[0] == 13);
+    }
+    std::printf("asset_lba=%u\n", lba);
+}
