+#include "game_boot.hpp"
+#include <cassert>
+#include <chrono>
+
+namespace fs = std::filesystem;
+
+void elf(const fs::path &path, unsigned type = 2)
+{
+    std::array<unsigned char, 52> header{};
+    header[0] = 0x7F; header[1] = 'E'; header[2] = 'L'; header[3] = 'F';
+    header[4] = 1; header[5] = 1; header[6] = 1;
+    header[16] = static_cast<unsigned char>(type); header[17] = static_cast<unsigned char>(type >> 8); header[18] = 8;
+    std::ofstream output(path, std::ios::binary);
+    output.write(reinterpret_cast<const char *>(header.data()), header.size());
+}
+
+void cnf(const fs::path &path, const std::string &text) { std::ofstream(path) << text; }
+
+void rejects(const fs::path &folder)
+{
+    bool rejected = false;
+    try { ps2::game::find_elf(folder); } catch (const std::runtime_error &) { rejected = true; }
+    assert(rejected);
+}
+
+int main()
+{
+    const auto folder = fs::temp_directory_path() / ("ps2 boot test " + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    fs::create_directories(folder);
+    try
+    {
+        rejects(folder);
+        elf(folder / "SLES_541.61");
+        elf(folder / "SIO2MAN.IRX", 0xFF80);
+        assert(ps2::game::find_elf(folder).filename() == "SLES_541.61");
+        elf(folder / "OTHER.ELF");
+        rejects(folder);
+        cnf(folder / "system.cnf", "BOOT = cdrom0:\\OTHER.ELF;1\r\nBOOT2 = cdrom0:\\SLES_541.61;1\r\n");
+        assert(ps2::game::find_elf(folder).filename() == "SLES_541.61");
+        cnf(folder / "system.cnf", "BOOT2 = cdrom0:\\MISSING.ELF;1\n");
+        rejects(folder);
+        cnf(folder / "system.cnf", "BOOT2 = cdrom0:\\SIO2MAN.IRX;1\n");
+        rejects(folder);
+        cnf(folder / "system.cnf", "BOOT2 = cdrom0:\\..\\OUTSIDE.ELF;1\n");
+        rejects(folder);
+        fs::create_directory(folder / "Sub folder");
+        elf(folder / "Sub folder" / "Core.ELF");
+        cnf(folder / "system.cnf", "  boot2 = \"cdrom0:\\Sub folder\\Core.ELF;1\"\r\n");
+        assert(ps2::game::find_elf(folder) == folder / "Sub folder" / "Core.ELF");
+        cnf(folder / "system.cnf", "BOOT2 = \"cdrom0:\\SLES_541.61;1\n");
+        rejects(folder);
+        fs::remove_all(folder);
+        std::puts("Automatic game ELF selection and SYSTEM.CNF handling passed.");
+    }
+    catch (...)
+    {
+        fs::remove_all(folder);
+        throw;
+    }
+}
